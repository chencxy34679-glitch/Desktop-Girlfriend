# ============================================
# 开发环境变量模板
# ============================================
# 用法:cp .env.example .env,填好本机实际值,然后:
#   set -a && . ./.env && set +a      # Git Bash
#   mvn spring-boot:run -Dspring-boot.run.profiles=dev
#
# .env 已被 .gitignore 忽略,不会被提交。
# 本文件(.env.example)只放占位符,不含任何真实凭证。

# ---- MySQL(必需)----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=desktop_gf_dev
MYSQL_USER=root
MYSQL_PASSWORD=在此填本机 MySQL root 密码

# ---- JWT(可选;不填则用 application-dev.yml 的开发默认值)----
# 生成命令:openssl rand -hex 32
JWT_SECRET=

# ---- DeepSeek(M2 接入 LLM 时必需)----
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- Redis(M2 计费阶段必需)----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- PostgreSQL + pgvector(M2 RAG 阶段必需)----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=desktop_gf_vec
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---- 阿里云 OSS(M2 商店/封面资源)----
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_PUBLIC=desktop-girlfriend-public
OSS_BUCKET_UPDATE=desktop-girlfriend-update

# ---- AES 主密钥(需要 EncryptUtil 时必需)----
# 生成命令:openssl rand -hex 32
DGF_ENCRYPT_KEY=

# ---- 高德开放平台(M3 Agent 天气/地图工具)----
# https://lbs.amap.com/api/webservice/create
AMAP_API_KEY=

# ---- 微信支付(M4 支付阶段)----
WECHAT_APPID=
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_API_V3_KEY=

# ---- 支付宝(M4 支付阶段)----
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
