{
  "name": "desktop-girlfriend",
  "version": "0.1.0",
  "description": "桌面宠物 - 洛琪希",
  "main": "./out/main/index.js",
  "author": "you",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build && npm run build:personal",
    "start": "node -e \"require('child_process').spawnSync('cmd',['/c','set ELECTRON_RUN_AS_NODE=&& electron-vite preview'],{stdio:'inherit',shell:true})\"",
    "run": "node -e \"require('child_process').spawnSync('cmd',['/c','set ELECTRON_RUN_AS_NODE=&& electron .'],{stdio:'inherit',shell:true})\"",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dev:electron": "node -e \"require('child_process').spawnSync('cmd',['/c','set ELECTRON_RUN_AS_NODE=&& electron-vite dev'],{stdio:'inherit',shell:true})\"",
    "dev:personal": "vite --config vite.personal.config.mjs",
    "probe:build": "esbuild src/main/window-state.ts --bundle --platform=node --format=cjs --external:electron --outfile=probes/.build/window-state.cjs",
    "probe:drag": "npm run probe:build && node probes/run.mjs probes/probe5-regression.js",
    "probe:drag:all": "npm run probe:build && node probes/run.mjs probes/probe1-drag-baseline.js probes/probe2-move-strategies.js probes/probe3-dpi-quantization.js probes/probe5-regression.js",
    "build:personal": "vite build --config vite.personal.config.mjs",
    "build:renderer": "electron-vite build"
  },
  "dependencies": {
    "@esotericsoftware/spine-canvas": "^4.0.31",
    "@esotericsoftware/spine-core": "^4.0.31",
    "@pxlkit/ui-kit-vue": "^2.2.0",
    "electron-store": "^10.0.0",
    "pinia": "^2.2.0",
    "pinia-plugin-persistedstate": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.0.0"
  },
  "build": {
    "appId": "com.example.desktopgirlfriend",
    "productName": "DesktopGirlfriend",
    "copyright": "Copyright © 2025",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DesktopGirlfriend"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "asar": true,
    "compression": "normal"
  }
}
