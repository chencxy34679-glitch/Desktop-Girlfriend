# ============================================
# Desktop Girlfriend - 顶层 .gitignore
# ============================================

# ---- 编辑器与系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# ---- git 备份目录(git filter-repo 前的历史快照,数 GB,不入仓)----
.git.backup-*/

# ---- 日志与临时 ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vite/
*.tsbuildinfo
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml

# ---- 桌面端(项目根 project/)构建产物 ----
node_modules/
out/
dist/
dist-electron/
release/

# ---- 原始素材备份(与 img/spine/roxy/ 内容重复,不入仓)----
Live2D/
# 版权素材(Neowiz/Round8《棕色尘埃2》仅个人学习,禁止再分发):
# 已通过 git filter-repo 从历史中剥离;下面这些规则防止本地副本被再次提交。
# 注意:gitignore 不支持行尾注释,每条规则单独一行写。
img/spine/roxy*/
img/spine/ailisi*/
img/spine/roxy_night/
img/spine/ailisi_night/
project/assets/characters/roxy/
project/assets/characters/roxy-night/
project/assets/characters/ailisi/
project/assets/characters/ailisi-night/
# 版权 Spine 资源在 project/ 下也有一份(开发期使用),同样不入仓
project/spine/roxy*/
project/spine/ailisi*/

# ============================================
# 后端 server/(M0 新增)
# ============================================
server/target/
server/.mvn/wrapper/maven-wrapper.jar
server/*.class
server/*.jar
server/*.war
server/dependency-reduced-pom.xml
server/hs_err_pid*
server/replay_pid*
server/.idea/
server/*.iml
server/.vscode/

# ---- Spring Boot ----
server/src/main/resources/application-local.yml
# application-prod.yml 应入仓(只是配置结构,不含敏感信息)
server/src/main/resources/application-prod-real.yml    # 实际部署填敏感 Key 的版本

# ============================================
# 后台 web-admin/(M4 新增)
# ============================================
web-admin/node_modules/
web-admin/dist/
web-admin/dist-ssr/
web-admin/.env.local
web-admin/.env.*.local
web-admin/*.local

# ============================================
# 部署 ops/(M0 新增)
# ============================================
ops/nginx/certs/
ops/secrets/
ops/.env
ops/*.env
ops/.env.local

# ============================================
# 数据库备份 / 凭证
# ============================================
*.sql.gz
*.dump
*.bak
*.key
*.pem
*.p12
*.pfx

# ============================================
# 文档构建产物(若使用 Sphinx / VuePress 等)
# ============================================
docs/.vuepress/dist/
docs/_build/
docs/site/

# ============================================
# 个人 / 临时
# ============================================
*.tmp
*~
.cache/
.tmp/
# Spine 3.x→4.1 转换前的原始文件备份
project/.spine-backup/

# 拖拽探针的 esbuild 产物(由 `npm run probe:build` 生成)
project/probes/.build/
